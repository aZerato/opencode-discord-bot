{
  "name": "opencode-discord-bot",
  "version": "0.1.0",
  "description": "Pont bidirectionnel sécurisé entre une instance locale d'OpenCode et un serveur Discord privé",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup:otp": "tsx src/scripts/setup-otp.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "otplib": "12.0.1",
    "qrcode": "^1.5.4",
    "strip-ansi": "^7.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
